{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": {
          "tools": ["Edit", "Write"],
          "file_paths": ["backend/**/*.py"]
        },
        "hooks": [
          {
            "type": "command",
            "command": "python -m ruff format --config pyproject.toml \"$CLAUDE_FILE_PATH\" 2>/dev/null; python -m ruff check --fix --config pyproject.toml \"$CLAUDE_FILE_PATH\" 2>/dev/null; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": {
          "tools": ["Edit", "Write"],
          "file_paths": ["data/*.db", ".env", ".env.*", "**/package-lock.json", "**/*.key", "**/*.pem"]
        },
        "hooks": [
          {
            "type": "command",
            "command": "echo 'BLOCKED: This file should not be edited by Claude Code' && exit 1"
          }
        ]
      }
    ]
  }
}

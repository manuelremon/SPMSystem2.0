# SPM v2.0 - Variables de Entorno para Produccion
# COPIAR A: .env.production (y CAMBIAR todos los valores)
# NO SUBIR .env.production A GIT

# ============================================================
# PostgreSQL Database
# ============================================================
POSTGRES_USER=spm
POSTGRES_PASSWORD=CAMBIAR_CONTRASEÑA_MINIMO_32_CARACTERES_AQUI
POSTGRES_DB=spm_production

# ============================================================
# Seguridad - GENERAR VALORES NUEVOS
# Comando: python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================
SECRET_KEY=CAMBIAR_GENERAR_CON_PYTHON_SECRETS
JWT_SECRET_KEY=CAMBIAR_GENERAR_CON_PYTHON_SECRETS

# ============================================================
# CORS - Dominio de produccion
# ============================================================
CORS_ORIGINS=https://planifica-materiales.com,https://www.planifica-materiales.com

# ============================================================
# SSL Email (para Let's Encrypt)
# ============================================================
SSL_EMAIL=admin@planifica-materiales.com

# ============================================================
# Push Notifications (Opcional)
# Generar: npx web-push generate-vapid-keys
# ============================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@planifica-materiales.com

# ============================================================
# Logging y Debug
# ============================================================
FLASK_ENV=production
LOG_LEVEL=INFO

# ============================================================
# Instrucciones para generar valores seguros
# ============================================================
#
# 1. POSTGRES_PASSWORD:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. SECRET_KEY y JWT_SECRET_KEY:
#    python -c "import secrets; print(secrets.token_hex(32))"
#    (ejecutar 2 veces para tener valores diferentes)
#
# 3. VAPID Keys (para push notifications):
#    npx web-push generate-vapid-keys
#

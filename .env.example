# SPM Configuration - Example (.env.example)
# Copy this file to .env and update with your values

# ============================================
# 🔧 BACKEND CONFIGURATION
# ============================================

# Flask Environment
FLASK_ENV=development
DEBUG=1
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars

# Render/Producción
RENDER_SERVICE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///backend/spm.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/spm_backend.log
# File Uploads
SPM_UPLOAD_DIR=./uploads
SPM_MAX_UPLOAD_SIZE=16777216  # 16MB in bytes

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@spm.local

# ============================================
# 🎨 FRONTEND CONFIGURATION
# ============================================

# API Configuration
VITE_API_URL=http://localhost:5000
VITE_API_TIMEOUT=30000
VITE_ENABLE_ANALYTICS=false

# Feature Flags
VITE_ENABLE_PLANNER=true
VITE_ENABLE_AI_CONSOLE=true
VITE_ENABLE_REPORTS=true

# ============================================
# 🐳 DOCKER CONFIGURATION
# ============================================

DOCKER_REGISTRY=localhost
DOCKER_IMAGE_NAME=spm
DOCKER_IMAGE_TAG=latest
DOCKER_PORT=5000
DOCKER_WORKERS=4

# ============================================
# 🧪 TESTING CONFIGURATION
# ============================================

# Production deployment testing (test_production.py)
# Set these before running production tests
TEST_BACKEND_URL=https://spmsystem2-0.onrender.com
TEST_FRONTEND_URL=https://spmv2-0.vercel.app
TEST_ADMIN_EMAIL=admin@spm.local
TEST_ADMIN_PASSWORD=your-test-admin-password

# ============================================
# 🤖 VERTEX IA (Google Gemini)
# ============================================

# Google AI API Key (from AI Studio)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Model to use (default: gemini-2.0-flash)
VERTEX_AI_MODEL=gemini-2.0-flash

# ============================================
# ⚡ GROQ (Inferencia ultrarapida - GRATIS)
# ============================================

# Groq API Key (from console.groq.com)
# Get your free key at: https://console.groq.com/keys
# Free tier: ~14,400 req/day, no credit card needed
GROQ_API_KEY=your-groq-api-key

# Model to use (default: llama-3.3-70b-versatile)
# Options: llama-3.3-70b-versatile, mixtral-8x7b-32768, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# 🧠 DEEPSEEK-R1 LOCAL (via Ollama)
# ============================================

# Ollama server URL (default: http://localhost:11434)
# Install Ollama: https://ollama.com
# Pull model: ollama pull deepseek-r1:latest
OLLAMA_BASE_URL=http://localhost:11434

# Deepseek model name in Ollama (default: deepseek-r1:latest)
# Options: deepseek-r1:latest (full), deepseek-r1:7b, deepseek-r1:14b
DEEPSEEK_MODEL=deepseek-r1:latest

# Default LLM provider for RAG ('gemini', 'anthropic', 'openai', 'deepseek', 'auto')
# 'auto' detects based on available API keys/services
DEFAULT_LLM_PROVIDER=auto

# ============================================
# 📊 PRODUCTION SETTINGS (Use only in prod)
# ============================================

# Uncomment and configure for production deployment:
# PROD_DATABASE_URL=postgresql://user:password@prod-db:5432/spm
# PROD_SECRET_KEY=production-secret-key-very-secure-min-32-chars
# PROD_LOG_LEVEL=WARNING
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# DATADOG_API_KEY=your-datadog-api-key

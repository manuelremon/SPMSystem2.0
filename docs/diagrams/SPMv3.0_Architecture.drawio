        <!-- ===== FLUJOS DE DATOS PRINCIPALES ===== -->
        <mxCell id="flows-title" value="KEY DATA FLOWS" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="50" y="1420" width="1300" height="30" as="geometry"/>
        </mxCell>

        <!-- Flow 1: Authentication -->
        <mxCell id="flow1-title" value="1️⃣ Authentication Flow" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#1976D2;" vertex="1" parent="1">
          <mxGeometry x="70" y="1460" width="300" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="flow1-text" value="Frontend (Login) → POST /api/auth/login → Validation → JWT Generation → httpOnly Cookies (Prod) or Bearer Token → Response → Zustand authStore → Authenticated UI" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fillColor=#E3F2FD;strokeColor=#1976D2;padding=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1485" width="650" height="60" as="geometry"/>
        </mxCell>

        <!-- Flow 2: Solicitudes Workflow -->
        <mxCell id="flow2-title" value="2️⃣ Solicitudes Workflow (FSM)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#1976D2;" vertex="1" parent="1">
          <mxGeometry x="70" y="1560" width="300" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="flow2-text" value="Create (draft) → Submit → FSM: draft → submitted → Notification Coordinator → Approve → FSM: submitted → approved → Budget consumption → SLA initiated → Planner (wizard) → processing → dispatched → closed" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fillColor=#E3F2FD;strokeColor=#1976D2;padding=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1585" width="650" height="60" as="geometry"/>
        </mxCell>

        <!-- Flow 3: Planner Wizard -->
        <mxCell id="flow3-title" value="3️⃣ Planner Wizard (4-Step)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#1976D2;" vertex="1" parent="1">
          <mxGeometry x="770" y="1460" width="300" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="flow3-text" value="Paso 1: Stock Analysis → Paso 2: Procurement Decision (stock vs purchase) → Paso 3: Review → Paso 4: Actions → MRP EOQ/ROP calculations → Purchase orders generated" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fillColor=#E3F2FD;strokeColor=#1976D2;padding=10;" vertex="1" parent="1">
          <mxGeometry x="770" y="1485" width="530" height="60" as="geometry"/>
        </mxCell>

        <!-- Flow 4: Forecast Pipeline -->
        <mxCell id="flow4-title" value="4️⃣ Demand Forecast" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#1976D2;" vertex="1" parent="1">
          <mxGeometry x="770" y="1560" width="300" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="flow4-text" value="Frontend /forecast/individual/{codigo} → Data Loader (PostgreSQL/SQLite historical) → Forecast Pipeline (ARIMA/Prophet/XGBoost) → Backtesting validation → Best model selection → 12-month prediction → Visualization" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fillColor=#E3F2FD;strokeColor:#1976D2;padding=10;" vertex="1" parent="1">
          <mxGeometry x="770" y="1585" width="530" height="60" as="geometry"/>
        </mxCell>

        <!-- Flow 5: Vertex AI Chat -->
        <mxCell id="flow5-title" value="5️⃣ Vertex AI Chat (RAG)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor:#1976D2;" vertex="1" parent="1">
          <mxGeometry x="70" y="1660" width="300" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="flow5-text" value="User Query → Cache check → RAG (ChromaDB embeddings + SQLite retrieval) → Context enrichment → Gemini API (temp: 0.1-0.3) → Anti-hallucination prompts → Response → Optional TTS → Cache storage" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fillColor=#E3F2FD;strokeColor:#1976D2;padding=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1685" width="650" height="60" as="geometry"/>
        </mxCell>

        <!-- Flow 6: Push Notifications -->
        <mxCell id="flow6-title" value="6️⃣ Web Push Notifications" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#1976D2;" vertex="1" parent="1">
          <mxGeometry x="770" y="1660" width="300" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="flow6-text" value="Register Service Worker → Push subscribe (VAPID) → POST /api/push/subscribe → Store endpoint in DB → Event trigger → push_service.send_notification → pywebpush (VAPID signature) → Browser push endpoint → showNotification" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fillColor:#E3F2FD;strokeColor:#1976D2;padding=10;" vertex="1" parent="1">
          <mxGeometry x="770" y="1685" width="530" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== TECHNOLOGIES SUMMARY ===== -->
        <mxCell id="tech-title" value="TECHNOLOGY STACK" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="50" y="1760" width="1300" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="tech-summary" value="Frontend: React 18 + Vite 5 + Material UI v7 + Tailwind CSS | Backend: Flask + SQLAlchemy | ML: ARIMA, Prophet, XGBoost, LSTM | Database: SQLite (dev) + PostgreSQL (prod) | AI: Google Gemini 2.0 Flash | Notifications: Web Push API + pywebpush | Real-time: WebSocket | TTS: Microsoft Edge TTS | Monitoring: Sentry + Structured Logging" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fillColor=#F5F5F5;strokeColor=#999;padding=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="1795" width="1300" height="80" as="geometry"/>
